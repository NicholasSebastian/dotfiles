{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": " -> "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "   User",
      "format": "{user-name}@{host-name}",
      "keyColor": "{{colors.terminal_normal_red.default.hex}}"
    },
    "break",
    {
      "type": "os",
      "key": "    OS",
      "keyColor": "{{colors.terminal_normal_yellow.default.hex}}",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "   ├─",
      "keyColor": "{{colors.terminal_normal_yellow.default.hex}}"
    },
    {
      "type": "packages",
      "key": "   ├─󰏖",
      "keyColor": "{{colors.terminal_normal_yellow.default.hex}}"
    },
    {
      "type": "shell",
      "key": "   └─",
      "keyColor": "{{colors.terminal_normal_yellow.default.hex}}"
    },
    "break",
    {
      "type": "wm",
      "key": "    DE/WM",
      "keyColor": "{{colors.terminal_normal_blue.default.hex}}"
    },
    {
      "type": "lm",
      "key": "   ├─󰧨",
      "keyColor": "{{colors.terminal_normal_blue.default.hex}}"
    },
    {
      "type": "terminal",
      "key": "   └─",
      "keyColor": "{{colors.terminal_normal_blue.default.hex}}"
    },
    "break",
    {
      "type": "host",
      "key": "   󰌢 PC",
      "keyColor": "{{colors.terminal_normal_green.default.hex}}"
    },
    {
      "type": "cpu",
      "key": "   ├─󰻠",
      "keyColor": "{{colors.terminal_normal_green.default.hex}}"
    },
    {
      "type": "gpu",
      "key": "   ├─󰍛",
      "keyColor": "{{colors.terminal_normal_green.default.hex}}"
    },
    {
      "type": "memory",
      "key": "   ├─󰑭",
      "keyColor": "{{colors.terminal_normal_green.default.hex}}"
    },
    {
      "type": "display",
      "key": "   ├─󰍹",
      "keyColor": "{{colors.terminal_normal_green.default.hex}}"
    },
    {
      "type": "physicaldisk",
      "key": "   └─",
      "keyColor": "{{colors.terminal_normal_green.default.hex}}"
    },
    "break",
    {
      "type": "sound",
      "key": "   󰝚 SOUND",
      "keyColor": "{{colors.terminal_normal_cyan.default.hex}}"
    },
    {
      "type": "player",
      "key": "   ├─󰥠",
      "keyColor": "{{colors.terminal_normal_cyan.default.hex}}"
    },
    {
      "type": "media",
      "key": "   └─󰎇",
      "keyColor": "{{colors.terminal_normal_cyan.default.hex}}"
    },
    "break"
  ]
}
