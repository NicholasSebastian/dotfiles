{
  "preferred_line_length": 120,
  "tab_size": 4,
  "format_on_save": "on",
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_fallbacks": ["monospace"],
  "cli_default_open_behavior": "new_window",
  "restore_on_startup": "launchpad",
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "lsp": {
    "typescript-ls": {
      "settings": {
        "package_version": "7.0.2"
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["typescript-ls", "oxlint", "oxfmt", "!vtsls", "!typescript-language-server"],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }]
    },
    "JSX": {
      "language_servers": ["typescript-ls", "oxlint", "oxfmt", "!vtsls", "!typescript-language-server"],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }]
    },
    "TypeScript": {
      "language_servers": ["typescript-ls", "oxlint", "oxfmt", "!vtsls", "!typescript-language-server"],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "oxlint", "oxfmt", "!vtsls", "!typescript-language-server"],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }]
    },
    "Vue.js": {
      "language_servers": ["oxlint", "oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }]
    },
    "Svelte": {
      "language_servers": ["oxlint", "oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }]
    },
    "Astro": {
      "language_servers": ["oxlint", "oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }]
    },
    "JSON": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "HTML": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "CSS": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "SCSS": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Less": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "YAML": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Markdown": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "MDX": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "GraphQL": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Handlebars": {
      "language_servers": ["oxfmt", "..."],
      "tab_size": 2,
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Ruby": { "tab_size": 2 },
    "Elixir": { "tab_size": 2 },
    "Dart": { "tab_size": 2 },
    "Nix": { "tab_size": 2 },
    "Go": { "hard_tabs": true, "tab_size": 4 },
    "Makefile": { "hard_tabs": true, "tab_size": 4 }
  },
  "language_models": {
    "opencode": {
      "show_go_models": true
    }
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "plan",
        "effort": "medium",
        "model": "opus"
      },
      "type": "registry"
    },
    "Oh My Pi": {
      "default_config_options": {
        "thinking": "medium",
        "mode": "plan"
      },
      "type": "custom",
      "command": "omp",
      "args": ["acp"]
    }
  },
  "agent": {
    "default_width": 320.0,
    "dock": "right",
    "threads_sidebar": {
      "position": "right"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "left"
  },
  "theme": {
    "mode": "system",
    "light": "Noctalia Light",
    "dark": "Noctalia Dark"
  },
  "icon_theme": "VSCode Icons for Zed (Dark)",
  "theme_overrides": {
    "Noctalia Dark": {
      "text": "#CCCCCC",
      "text.muted": "#CCCCCC",
      "text.placeholder": "#FFFFFF56",
      "text.disabled": "#CCCCCC80",
      "editor.foreground": "#CCCCCC",
      "link_text.hover": "#4DAAFC",
      "hint": "#969696",
      "version_control.added": "#2EA043",
      "version_control.deleted": "#F85149",
      "version_control.modified": "#0078D4",
      "version_control.renamed": "#73C991",
      "version_control.conflict": "#E4676B",
      "version_control.ignored": "#8C8C8C",
      "version_control.conflict_marker.ours": "#40C8AE80",
      "version_control.conflict_marker.theirs": "#40A6FF80",
      "created": "#81B88B",
      "modified": "#E2C08D",
      "deleted": "#C74E39",
      "renamed": "#73C991",
      "conflict": "#E4676B",
      "ignored": "#8C8C8C",
      "syntax": {
        "attribute": { "color": "#9CDCFE" },
        "boolean": { "color": "#569CD6" },
        "comment": { "color": "#6A9955" },
        "comment.doc": { "color": "#6A9955" },
        "constant": { "color": "#4FC1FF" },
        "constructor": { "color": "#569CD6" },
        "embedded": { "color": "#D4D4D4" },
        "emphasis.strong": { "color": "#569CD6", "font_weight": 700 },
        "function": { "color": "#DCDCAA" },
        "function.macro": { "color": "#569CD6" },
        "keyword": { "color": "#569CD6" },
        "keyword.declaration": { "color": "#569CD6" },
        "keyword.control": { "color": "#C586C0" },
        "keyword.import": { "color": "#C586C0" },
        "number": { "color": "#B5CEA8" },
        "operator": { "color": "#D4D4D4" },
        "preproc": { "color": "#569CD6" },
        "property": { "color": "#9CDCFE" },
        "punctuation": { "color": "#CCCCCC" },
        "punctuation.bracket": { "color": "#CCCCCC" },
        "punctuation.delimiter": { "color": "#CCCCCC" },
        "punctuation.list_marker": { "color": "#CCCCCC" },
        "punctuation.special": { "color": "#CCCCCC" },
        "string": { "color": "#CE9178" },
        "string.escape": { "color": "#D7BA7D" },
        "string.regex": { "color": "#D16969" },
        "string.special": { "color": "#D16969" },
        "string.special.symbol": { "color": "#D16969" },
        "tag": { "color": "#569CD6" },
        "tag.component.jsx": { "color": "#4EC9B0" },
        "text.literal": { "color": "#CE9178" },
        "type": { "color": "#4EC9B0" },
        "type.builtin": { "color": "#569CD6" },
        "variable": { "color": "#9CDCFE" },
        "variable.special": { "color": "#569CD6" }
      }
    }
  },
  "auto_install_extensions": {
    "tsgo": true,
    "oxc": true
  }
}
