# Managed by chezmoi. Only values that differ from Hermes' defaults: Hermes merges this file over its built-in defaults.
_config_version: 53

model:
  default: claude-sonnet-5-5
  provider: anthropic
  base_url: "https://api.anthropic.com"
  api_mode: anthropic_messages

agent:
  image_input_mode: native  # keep Claude seeing images directly now that auxiliary.vision is pinned
  reasoning_overrides:
    "openrouter/deepseek/deepseek-v4.1-flash-1017": low  # main-chain fallback step 3
  max_turns: 150
  reasoning_effort: medium
  verbose: false

terminal:
  backend: docker
  docker_run_as_host_user: true  # files the agent writes in the vault stay owned by you, so Obsidian can edit them
  docker_env:  # the vault for the obsidian and llm-wiki skills, read in the sandbox
    OBSIDIAN_VAULT_PATH: "{{ .chezmoi.homeDir }}/hermes-workspace/vault"
    WIKI_PATH: "{{ .chezmoi.homeDir }}/hermes-workspace/vault"
  docker_volumes:
    - "{{ .chezmoi.homeDir }}/hermes-workspace:{{ .chezmoi.homeDir }}/hermes-workspace"  # at its host path, so file paths the agent reports open on the host
    - "{{ .chezmoi.homeDir }}/hermes-workspace/vault/read-only:{{ .chezmoi.homeDir }}/hermes-workspace/vault/read-only:ro"
    - "{{ .chezmoi.homeDir }}/.local/share/hermes/vault-private-mask:{{ .chezmoi.homeDir }}/hermes-workspace/vault/private:ro"  # empty: hides vault/private
  container_disk: 0  # 0 = no per-container disk quota (overlay2 here cannot enforce one; Hermes warns on every start otherwise)

prompt_caching:
  cache_ttl: auto

memory: {}

skills:
  creation_nudge_interval: 15
  project_discovery: false  # the sandbox cwd (/root) is not a host path; scanning it for project skills only spams warnings

plugins:
  disabled: []
  enabled: [advanced-delegation, agent-importers]

platform_toolsets:
  cli: [browser, clarify, code_execution, computer_use, connections, cronjob, delegation, file, image_gen, memory, session_search, skills, terminal, todo, tts, vision, web]

known_plugin_toolsets:
  cli: [a2a]

known_builtin_toolsets:
  cli: [browser, clarify, code_execution, computer_use, connections, context_engine, cronjob, delegation, discord, discord_admin, file, image_gen, kanban, memory, session_search, skills, stt, terminal, todo, tts, video, video_gen, vision, web, x_search, yuanbao]

providers:
  ollama:
    name: Ollama
    base_url: "http://localhost:11434/v1"
    api_key: ollama
    api_mode: chat_completions
    model: "qwen3.5:4b-64k"
    default_model: "qwen3.5:4b-64k"
    discover_models: true
    models:
      "qwen3.5:4b-64k":
        context_length: 65536

custom_providers:
  - name: Groq
    base_url: "https://api.groq.com/openai/v1"
    key_env: HERMES_CUSTOM_API_GROQ_COM_API_KEY
    model: qwen/qwen3.8-27b
    api_mode: chat_completions
    models:
      allam-2-7b: {}
      canopylabs/orpheus-arabic-saudi: {}
      canopylabs/orpheus-v1-english: {}
      meta-llama/llama-prompt-guard-2-22m: {}
      meta-llama/llama-prompt-guard-2-86m: {}
      openai/gpt-oss-120b: {}
      openai/gpt-oss-20b: {}
      openai/gpt-oss-safeguard-20b: {}
      qwen/qwen3.8-27b: {}
      whisper-large-v3: {}
      whisper-large-v3-turbo: {}
    models_discovered: true

fallback_providers:
  - provider: openrouter
    model: thinkingmachines/inkling-2-small:free
  - provider: openrouter
    model: nvidia/nemotron-3.5-super-vl:free
  - provider: openrouter
    model: deepseek/deepseek-v4.1-flash-1017

auxiliary:
  openrouter_model: "nvidia/nemotron-3.5-super-vl:free"  # aux auto-chain backup (default is paid gemini-3.6-flash)
  vision:
    provider: "custom:groq"
    model: qwen/qwen3.8-27b
  voice_chat:
    provider: anthropic
    model: claude-haiku-5-5
    reasoning_effort: none
  kanban_decomposer:
    provider: anthropic
    model: claude-haiku-5-5
    reasoning_effort: high
  compression:
    provider: openrouter
    model: deepseek/deepseek-v4.1-flash-1017
    reasoning_effort: none
    extra_body:
      provider: {order: [deepseek, morph, inference-net], allow_fallbacks: true}
  title_generation:
    provider: ollama
    model: "qwen3.5:4b-64k"
    base_url: "http://localhost:11434/v1"
    reasoning_effort: low
  mcp:
    provider: openrouter
    model: deepseek/deepseek-v4.1-flash-1017
    reasoning_effort: low
    extra_body:
      provider: {order: [deepseek, morph, inference-net], allow_fallbacks: true}
  triage_specifier:
    provider: openrouter
    model: deepseek/deepseek-v4.1-flash-1017
    reasoning_effort: low
    extra_body:
      provider: {order: [deepseek, morph, inference-net], allow_fallbacks: true}
  profile_describer:
    provider: ollama
    model: "qwen3.5:4b-64k"
    base_url: "http://localhost:11434/v1"
  approval:
    provider: anthropic
    model: claude-haiku-5-5
  curator:
    provider: anthropic
    model: claude-haiku-5-5
  review:
    provider: anthropic
    model: claude-opus-5-5
    reasoning_effort: medium

delegation:
  fallback_providers:
    - provider: openrouter
      model: deepseek/deepseek-v4.1-flash-1017
    - provider: openrouter
      model: nvidia/nemotron-3.5-super-vl:free
  backend: model_map
  backends:
    model_map:
      options:
        - name: fast
          description: "Quick: web lookups, reading and summarizing pages or files, simple extraction. Prefer for bulk or parallel tasks."
          provider: anthropic
          model: claude-haiku-5-5
          reasoning_effort: low
          fallback_providers:
            - provider: openrouter
              model: nvidia/nemotron-3.5-super-vl:free
            - provider: openrouter
              model: deepseek/deepseek-v4.1-flash-1017
        - name: standard
          description: "Multi-step work needing judgment: research that compares sources, drafting, organizing findings."
          provider: anthropic
          model: claude-haiku-5-5
          reasoning_effort: medium
        - name: deep
          description: "Hardest reasoning only: architecture, tricky debugging, critical analysis, final synthesis. Uses the most quota."
          provider: anthropic
          model: claude-opus-5-5
          reasoning_effort: high
          fallback_providers:
            - provider: anthropic
              model: claude-sonnet-5-5
            - provider: openrouter
              model: deepseek/deepseek-v4.1-flash-1017
      default: standard

moa:
  enabled: true
  default_preset: council
  presets:
    council:
      enabled: true
      reference_models:
        - provider: anthropic
          model: claude-haiku-5-5
          enabled: true
        - provider: "custom:groq"
          model: qwen/qwen3.8-27b
          enabled: true
      aggregator:
        provider: anthropic
        model: claude-opus-5-5
      degraded_reference_policy: loud
      fanout: user_turn
      reference_max_tokens: 600
  reference_models:
    - provider: anthropic
      model: claude-haiku-5-5
      enabled: true
    - provider: "custom:groq"
      model: qwen/qwen3.8-27b
      enabled: true
  aggregator:
    provider: anthropic
    model: claude-opus-5-5
  degraded_reference_policy: loud
  fanout: user_turn

code_execution:
  max_tool_calls: 50
  timeout: 300

web:
  backend: parallel
  provider_tier:
    parallel: free

computer_use:
  backend: cua

display:
  cleanup_progress: false
  streaming: true

desktop:
  disable_gpu: false
  electron_flags:
    - "--ignore-gpu-blocklist"
    - "--enable-gpu-rasterization"
    - "--enable-zero-copy"
  manage_launcher_entry: false

gateway:
  service_install_choice: install

group_sessions_per_user: true

updates:
  pre_update_backup: false

telemetry:
  shared_metrics:
    offer_version: 2
