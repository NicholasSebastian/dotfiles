# Managed by chezmoi. Only values that differ from Hermes' defaults: Hermes merges this file over its built-in defaults.
_config_version: 51

model:
  default: claude-haiku-5-5
  provider: anthropic
  base_url: "https://api.anthropic.com"
  api_mode: anthropic_messages

agent:
  max_turns: 150
  reasoning_effort: medium
  verbose: false
  disabled_toolsets: [delegation, code_execution, session_search, cronjob]

terminal:
  backend: docker
  cwd: "/workspace"
  docker_run_as_host_user: true  # files the agent writes in the vault stay owned by you, so Obsidian can edit them
  docker_forward_env: [OBSIDIAN_VAULT_PATH, WIKI_PATH]
  docker_volumes:
    - "{{ .chezmoi.homeDir }}/hermes-workspace:/workspace"
    - "{{ .chezmoi.homeDir }}/hermes-workspace/vault/read-only:/workspace/vault/read-only:ro"
    - "{{ .chezmoi.homeDir }}/.local/share/hermes/vault-private-mask:/workspace/vault/private:ro"  # empty: hides vault/private
  container_disk: 0  # 0 = no per-container disk quota (overlay2 here cannot enforce one; Hermes warns on every start otherwise)

prompt_caching:
  cache_ttl: auto

memory:
  memory_char_limit: 1100
  user_char_limit: 700

skills:
  creation_nudge_interval: 15
  project_discovery: false  # the sandbox cwd (/workspace) is not a host path; scanning it for project skills only spams warnings
  disabled:
    - airtable
    - architecture-diagram
    - arxiv
    - ascii-video
    - baoyu-infographic
    - box
    - claude-code
    - claude-design
    - codebase-inspection
    - codex
    - computer-use
    - design-md
    - document-to-action-items
    - docx
    - dogfood
    - email-inbox-triage
    - gif-search
    - github
    - google-workspace
    - hermes-agent-skill-authoring
    - himalaya
    - humanizer
    - inspecting-hermes-desktop-dom
    - llm-wiki
    - manim-video
    - meeting-action-items
    - node-inspect-debugger
    - notion
    - obsidian
    - opencode
    - p5js
    - popular-web-designs
    - powerpoint
    - python-debugpy
    - requesting-code-review
    - simplify-code
    - songsee
    - songwriting-and-ai-music
    - spike
    - systematic-debugging
    - teams-meeting-pipeline
    - test-driven-development
    - weekly-review-planning
    - xlsx
    - xurl

plugins:
  disabled: []
  enabled: [advanced-delegation, agent-importers]

platform_toolsets:
  cli: [browser, clarify, code_execution, computer_use, connections, cronjob, delegation, file, image_gen, memory, session_search, skills, terminal, todo, tts, vision, web]

known_plugin_toolsets:
  cli: [a2a]

known_builtin_toolsets:
  cli: [browser, clarify, code_execution, computer_use, connections, context_engine, cronjob, delegation, discord, discord_admin, file, image_gen, kanban, memory, session_search, skills, stt, terminal, todo, tts, video, video_gen, vision, web, x_search, yuanbao]

providers:
  ollama:
    name: Ollama
    base_url: "http://localhost:11434/v1"
    api_key: ollama
    api_mode: chat_completions
    model: "qwen3.5:4b-64k"
    default_model: "qwen3.5:4b-64k"
    discover_models: true
    models:
      "qwen3.5:4b-64k":
        context_length: 65536

custom_providers:
  - name: Groq
    base_url: "https://api.groq.com/openai/v1"
    key_env: HERMES_CUSTOM_API_GROQ_COM_API_KEY
    model: openai/gpt-oss-120b
    api_mode: chat_completions
    models:
      allam-2-7b: {}
      canopylabs/orpheus-arabic-saudi: {}
      canopylabs/orpheus-v1-english: {}
      meta-llama/llama-prompt-guard-2-22m: {}
      meta-llama/llama-prompt-guard-2-86m: {}
      openai/gpt-oss-120b: {}
      openai/gpt-oss-20b: {}
      openai/gpt-oss-safeguard-20b: {}
      qwen/qwen3.8-27b: {}
      whisper-large-v3: {}
      whisper-large-v3-turbo: {}
    models_discovered: true

auxiliary:
  compression:
    provider: ollama
    model: "qwen3.5:4b-64k"
    base_url: "http://localhost:11434/v1"
    reasoning_effort: low
  title_generation:
    provider: ollama
    model: "qwen3.5:4b-64k"
    base_url: "http://localhost:11434/v1"
    reasoning_effort: low
  skills_hub:
    provider: ollama
    model: "qwen3.5:4b-64k"
    base_url: "http://localhost:11434/v1"
  mcp:
    provider: ollama
    model: "qwen3.5:4b-64k"
    base_url: "http://localhost:11434/v1"
    reasoning_effort: low
  triage_specifier:
    provider: ollama
    model: "qwen3.5:4b-64k"
    base_url: "http://localhost:11434/v1"
  profile_describer:
    provider: ollama
    model: "qwen3.5:4b-64k"
    base_url: "http://localhost:11434/v1"
  approval:
    provider: anthropic
    model: claude-haiku-5-5
  curator:
    provider: anthropic
    model: claude-haiku-5-5
  review:
    provider: anthropic
    model: claude-opus-5-5
    reasoning_effort: medium

delegation:
  backend: model_map
  backends:
    model_map:
      options:
        - name: fast
          description: "Quick: web lookups, reading and summarizing pages or files, simple extraction. Prefer for bulk or parallel tasks."
          provider: anthropic
          model: claude-haiku-5-5
          reasoning_effort: low
        - name: standard
          description: "Multi-step work needing judgment: research that compares sources, drafting, organizing findings."
          provider: anthropic
          model: claude-haiku-5-5
          reasoning_effort: medium
        - name: deep
          description: "Hardest reasoning only: architecture, tricky debugging, critical analysis, final synthesis. Uses the most quota."
          provider: anthropic
          model: claude-opus-5-5
          reasoning_effort: high
      default: standard

moa:
  enabled: true
  default_preset: council
  presets:
    council:
      enabled: true
      reference_models:
        - provider: anthropic
          model: claude-haiku-5-5
          enabled: true
        - provider: "custom:groq"
          model: openai/gpt-oss-120b
          enabled: true
      aggregator:
        provider: anthropic
        model: claude-opus-5-5
      degraded_reference_policy: loud
      fanout: user_turn
      reference_max_tokens: 600
  reference_models:
    - provider: anthropic
      model: claude-haiku-5-5
      enabled: true
    - provider: "custom:groq"
      model: openai/gpt-oss-120b
      enabled: true
  aggregator:
    provider: anthropic
    model: claude-opus-5-5
  degraded_reference_policy: loud
  fanout: user_turn

code_execution:
  max_tool_calls: 50
  timeout: 300

web:
  backend: parallel
  provider_tier:
    parallel: free

computer_use:
  backend: cua

display:
  cleanup_progress: false
  streaming: true

desktop:
  disable_gpu: false
  electron_flags:
    - "--ignore-gpu-blocklist"
    - "--enable-gpu-rasterization"
    - "--enable-zero-copy"
  manage_launcher_entry: false

gateway:
  service_install_choice: install

group_sessions_per_user: true

updates:
  pre_update_backup: false

telemetry:
  shared_metrics:
    offer_version: 2
